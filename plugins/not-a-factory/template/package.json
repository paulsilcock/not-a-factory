{
  "name": "{{APP_NAME}}",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.14.1"
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter api start",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "pnpm test:unit && pnpm test:acceptance",
    "test:unit": "pnpm --filter api --filter web test",
    "test:acceptance": "pnpm --filter acceptance-tests test",
    "test:acceptance:down": "docker compose -p acceptance --profile app down -v",
    "test:changed": "pnpm -r test:changed",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate": "pnpm --filter api db:migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tanstack/intent": "^0.5.6"
  },
  "intent": {
    "skills": [
      "@tanstack/*"
    ]
  }
}
