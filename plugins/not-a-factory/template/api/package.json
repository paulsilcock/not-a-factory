{
  "name": "api",
  "private": true,
  "type": "module",
  "imports": {
    "#api/*": "./src/*",
    "#acceptance/*": "./test-acceptance/*"
  },
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:acceptance": "vitest run --project acceptance",
    "test:changed": "vitest run --project unit --changed",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "@litmus-ts/core": "^0.1.0-rc.3",
    "@litmus-ts/db": "^0.1.0-rc.3",
    "@litmus-ts/http": "^0.1.0-rc.3",
    "@litmus-ts/log": "^0.1.0-rc.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.23.15",
    "tsyringe": "^4.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.6",
    "@litmus-ts/test": "^0.1.0-rc.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
